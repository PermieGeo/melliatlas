{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MelliAtlas feature cross-reference",
  "description": "Maps stable feature IDs to specification stages, code ownership, and tests. Feature descriptions live in docs/FEATURES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "stages",
          "spec_paths",
          "owners",
          "test_files"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:\\.[A-Z][A-Z0-9_]*)+$"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9.-]{0,31}$"
            }
          },
          "spec_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^docs/specs/(?:active|archive)/subspecs/subspec-[0-9]{2}-[a-z0-9-]+\\.md$"
            }
          },
          "owners": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+(?:#[A-Za-z_$][A-Za-z0-9_.$-]*)?$"
            }
          },
          "test_files": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            }
          }
        }
      }
    }
  }
}
