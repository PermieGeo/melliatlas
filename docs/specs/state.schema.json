{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apatch SDD processing checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "selectedWorkstreamId",
    "workstreams",
    "featureAcceptances"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "SINGLE"
    },
    "selectedWorkstreamId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "specPath",
          "stageId",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "specPath": {
            "type": "string",
            "pattern": "^docs/specs/active/subspecs/subspec-[0-9]{2}-[a-z0-9-]+\\.md$"
          },
          "stageId": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9.-]{0,31}$"
          },
          "phase": {
            "enum": [
              "DESIGN",
              "READY_FOR_IMPLEMENTATION",
              "READY_FOR_REVIEW",
              "AWAITING_DEVELOPER_DECISION",
              "BLOCKED",
              "PAUSED",
              "ON_HOLD"
            ]
          }
        }
      }
    },
    "featureAcceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "featureId",
          "acceptanceIds",
          "evidenceFiles",
          "approvalReference"
        ],
        "properties": {
          "featureId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:\\.[A-Z][A-Z0-9_]*)+$"
          },
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:MVP01-BE-A[0-9]{2}|MVP-[0-9]{2}\\.A[0-9]{2})$"
            }
          },
          "evidenceFiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            }
          },
          "approvalReference": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          }
        }
      }
    },
    "selectedTaskPath": {
      "type": "string",
      "pattern": "^docs/specs/active/tasks/[a-z0-9-]+/task\\.md$"
    }
  }
}
