{
  "name": "@melliatlas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e index.html package.json tsconfig.json vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests e2e index.html package.json tsconfig.json vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "@eslint/js": "^9.0.0"
  }
}
